# ==============================================================================
# CarMachi — Server Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Fill in the values below before starting the application.
# ==============================================================================

# Server Port (Default is 3001)
PORT=3001

# MongoDB Atlas Connection String (Required for Auth & Saved Shortlists)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/carmachi?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string_here

# JWT Secret Key for Session Authentication (Use a strong random string)
# Example generation: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here

# Environment Mode ('development' | 'production')
NODE_ENV=development
